# Copy to .env and fill in. NEVER commit the real .env.

# ── Front (Vite) ──────────────────────────────────────────────
# Backend adapter: mock (default, no backend needed) | supabase
VITE_DATA_BACKEND=mock
# Supabase project (Settings → API) — only needed when VITE_DATA_BACKEND=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Migration script + admin (server-side only) ───────────────
SUPABASE_URL=
# Settings → API → service_role key (bypasses RLS — keep secret)
SUPABASE_SERVICE_ROLE_KEY=
# Settings → Database → connection string (for TRUNCATE/setval)
SUPABASE_DB_URL=

# ── SharePoint (Azure AD App Registration) ───────────────────
# The "99." ABM lists stay on SharePoint (shared with another Power App).
# Reading (migration + catalog sync) needs application permission Sites.Read.All;
# WRITING the shared lists (Articulos) needs Sites.ReadWrite.All + admin consent.
# MS_CLIENT_SECRET is server-side only — also load these into the Supabase Edge Function:
#   supabase secrets set MS_TENANT_ID=... MS_CLIENT_ID=... MS_CLIENT_SECRET=... SP_SITE_URL=...
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SP_SITE_URL=https://sumardigital.sharepoint.com/sites/TopRentals

# ── Vercel Cron (catalog sync) ───────────────────────────────
# The catalog sync runs on Vercel Cron (vercel.json -> /api/catalog-sync).
# Set the 6 server-side vars above (MS_*/SP_SITE_URL/SUPABASE_*) in Vercel
# Project Settings too (no VITE_ prefix). CRON_SECRET is a shared token Vercel
# Cron sends as `Authorization: Bearer <CRON_SECRET>`; the function rejects any
# request without it. NOTE: */5-min cron requires a Vercel Pro plan (Hobby = 1/day).
CRON_SECRET=

# ── Emails (later phase — Microsoft Graph Mail.Send) ──────────
# Sender mailbox for transactional emails
MAIL_SENDER=
# Replaces the hardcoded BCC list from the PowerApps hidden label
NOTIFICATIONS_BCC=

{
  "name": "toprentals-migrate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-shot SharePoint -> Supabase data migration for TopRentals (wipe-and-load, production cutover).",
  "scripts": {
    "migrate": "node --experimental-strip-types src/index.ts",
    "dry-run": "node --experimental-strip-types src/index.ts --dry-run",
    "fix:usuarios:dry": "node --experimental-strip-types src/fix-usuarios-sp.ts",
    "fix:usuarios": "node --experimental-strip-types src/fix-usuarios-sp.ts --apply",
    "migrate:tecnoapp":"node --experimental-strip-types src/tecnoapp.ts",
    "migrate:tecnoapp:dry": "node --experimental-strip-types src/tecnoapp.ts --dry-run",
    "migrate:tecnoapp:update": "node --experimental-strip-types src/tecnoapp.ts --update",
    "migrate:tecnoapp:update:dry": "node --experimental-strip-types src/tecnoapp.ts --update --dry-run",
    "check":"node --experimental-strip-types src/checks.ts",
    "provision-auth": "node --experimental-strip-types src/provision-auth.ts",
    "provision-auth:dry-run": "node --experimental-strip-types src/provision-auth.ts --dry-run",
    "backfill-passwords": "node --experimental-strip-types src/backfill-passwords-sp.ts",
    "backfill-passwords:dry-run": "node --experimental-strip-types src/backfill-passwords-sp.ts --dry-run",
    "reconcile-ventilaciones": "node --experimental-strip-types src/reconcile-ventilaciones.ts",
    "apply-groupings": "node --experimental-strip-types src/apply-groupings.ts",
    "send-samples": "node --experimental-strip-types src/send-sample-emails.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  }
}
